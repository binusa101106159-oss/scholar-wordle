{"id":"c004-t2","guide":"c004","label":"表二","title":"暴露於硫化氫各濃度之症狀[2, 29]","blocks":[{"t":"p","text":"表二 暴露於硫化氫各濃度之症狀[2, 29]","cap":"c004-t2"},{"t":"table","widths":[95.4,10.8,296.0],"rows":[[{"c":0,"rs":1,"cs":1,"text":"濃度（ppm）"},{"c":1,"rs":1,"cs":1,"text":""},{"c":2,"rs":1,"cs":1,"text":"症狀/影響"}],[{"c":0,"rs":1,"cs":2,"text":"0.00011 至0.00033"},{"c":2,"rs":1,"cs":1,"text":"一般背景濃度"}],[{"c":0,"rs":1,"cs":2,"text":"0.01 至 1.5"},{"c":2,"rs":1,"cs":1,"text":"嗅覺閾值（腐敗臭蛋味）"}],[{"c":0,"rs":1,"cs":2,"text":"2 至 5"},{"c":2,"rs":1,"cs":1,"text":"經長時間暴露可能導致噁心、流淚、頭痛，在氣喘病人可能造成氣喘發作"}],[{"c":0,"rs":1,"cs":2,"text":"20"},{"c":2,"rs":1,"cs":1,"text":"疲勞、食慾變差、頭痛、易怒、記憶力變差、頭暈，可能造成眼睛刺激"}],[{"c":0,"rs":1,"cs":2,"text":"50 至 100"},{"c":2,"rs":1,"cs":1,"text":"暴露超過一小時後，造成輕微結膜炎（眼睛燻煙，gas eye）及呼吸道刺激，以及噁心和食慾變差"}],[{"c":0,"rs":1,"cs":1,"text":"100"},{"c":1,"rs":1,"cs":2,"text":"眼睛和呼吸道明顯刺激、噁心、頭痛"}],[{"c":0,"rs":1,"cs":1,"text":"100 至 150"},{"c":1,"rs":1,"cs":2,"text":"嗅覺喪失（嗅神經麻痺）"}],[{"c":0,"rs":1,"cs":1,"text":"200 至 300"},{"c":1,"rs":1,"cs":2,"text":"眼睛和呼吸道嚴重刺激，可能導致肺水腫"}],[{"c":0,"rs":1,"cs":1,"text":"500 至 700"},{"c":1,"rs":1,"cs":2,"text":"步態不穩，數分鐘內喪失意識，30-60 分鐘內死亡"}],[{"c":0,"rs":1,"cs":1,"text":"700 至 1000"},{"c":1,"rs":1,"cs":2,"text":"迅速喪失意識，擊倒效應（ knockdown phenomenon），吸入一兩口氣後立即昏倒，可能在數分鐘內死亡"}],[{"c":0,"rs":1,"cs":1,"text":"1000 至 2000"},{"c":1,"rs":1,"cs":2,"text":"幾乎立即死亡"}]],"head":1,"att":"c004-t2"}]}