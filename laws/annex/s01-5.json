t":"1"}],[{"c":0,"rs":1,"cs":1,"text":"16"},{"c":1,"rs":1,"cs":1,"text":"職場健康管理及指導（含母性及中高齡健康保護）"},{"c":2,"rs":1,"cs":1,"text":"2"}],[{"c":0,"rs":1,"cs":1,"text":"17"},{"c":1,"rs":1,"cs":1,"text":"職業健康服務實務案例分享（含健康服務紀錄實例）"},{"c":2,"rs":1,"cs":1,"text":"2"}],[{"c":0,"rs":1,"cs":1,"text":"18"},{"c":1,"rs":1,"cs":1,"text":"健康風險評估概論"},{"c":2,"rs":1,"cs":1,"text":"2"}],[{"c":0,"rs":1,"cs":1,"text":"19"},{"c":1,"rs":1,"cs":1,"text":"台灣職業病鑑定及補償簡介"},{"c":2,"rs":1,"cs":1,"text":"1"}],[{"c":0,"rs":1,"cs":1,"text":"20"},{"c":1,"rs":1,"cs":1,"text":"肌肉骨骼系統傷病及人因工程"},{"c":2,"rs":1,"cs":1,"text":"2"}],[{"c":0,"rs":1,"cs":1,"text":"21"},{"c":1,"rs":1,"cs":1,"text":"職場心理健康評估"},{"c":2,"rs":1,"cs":1,"text":"1"}],[{"c":0,"rs":1,"cs":1,"text":"22"},{"c":1,"rs":1,"cs":1,"text":"職場常見非職業性疾病之健康管理-代謝症候群、心血管疾病及肝功能概論"},{"c":2,"rs":1,"cs":1,"text":"2"}],[{"c":0,"rs":1,"cs":1,"text":"23"},{"c":1,"rs":1,"cs":1,"text":"選配工、復工與失能管理概論及介紹"},{"c":2,"rs":1,"cs":1,"text":"4"}],[{"c":0,"rs":1,"cs":1,"text":"24"},{"c":1,"rs":1,"cs":1,"text":"工廠訪視及工業衛生概論"},{"c":2,"rs":1,"cs":1,"text":"3"}],[{"c":0,"rs":1,"cs":1,"text":"25"},{"c":1,"rs":1,"cs":1,"text":"事業單位之預防醫學及疫情管理"},{"c":2,"rs":1,"cs":1,"text":"2"}],[{"c":0,"rs":1,"cs":2,"text":"合計"},{"c":2,"rs":1,"cs":1,"text":"50"}]],"head":1},{"t":"p","text":"備註：","center":false},{"t":"p","text":"1.除50小時學分課程外，需另與職業醫學科專科醫師至事業單位臨場服務實習2次並交付臨場服務報告書，經考試及報告書審核通過，方為訓練合格。","center":false},{"t":"p","text":"2.曾接受從事辦理勞工體格及健康檢查業務之醫師訓練課程合格者，可抵免1至14項次28小時學分課程。","center":false}],"law":"s01","label":"附表五","title":"從事勞工健康服務之醫師訓練課程與時數表"}