":"25"},{"c":15,"rs":1,"cs":1,"text":"27"},{"c":16,"rs":1,"cs":1,"text":"31"},{"c":17,"rs":1,"cs":1,"text":"33"},{"c":18,"rs":1,"cs":1,"text":"35"},{"c":19,"rs":1,"cs":1,"text":"37"},{"c":20,"rs":1,"cs":1,"text":"39"},{"c":21,"rs":1,"cs":1,"text":"41"},{"c":22,"rs":1,"cs":1,"text":"43"},{"c":23,"rs":1,"cs":1,"text":"45"},{"c":24,"rs":1,"cs":1,"text":"47"},{"c":25,"rs":1,"cs":1,"text":"49"},{"c":26,"rs":1,"cs":1,"text":"51"},{"c":27,"rs":1,"cs":1,"text":"53"},{"c":28,"rs":1,"cs":1,"text":"55"},{"c":29,"rs":1,"cs":1,"text":"57"},{"c":30,"rs":1,"cs":1,"text":"59"},{"c":31,"rs":1,"cs":1,"text":"61"},{"c":32,"rs":1,"cs":1,"text":"61"},{"c":33,"rs":1,"cs":1,"text":"61"}],[{"c":0,"rs":1,"cs":1,"text":"月退休金"},{"c":1,"rs":1,"cs":1,"text":"百分比"},{"c":2,"rs":1,"cs":1,"text":"(5)"},{"c":3,"rs":1,"cs":1,"text":"(10)"},{"c":4,"rs":1,"cs":1,"text":"(15)"},{"c":5,"rs":1,"cs":1,"text":"(20)"},{"c":6,"rs":1,"cs":1,"text":"(25)"},{"c":7,"rs":1,"cs":1,"text":"(30)"},{"c":8,"rs":1,"cs":1,"text":"(35)"},{"c":9,"rs":1,"cs":1,"text":"(40)"},{"c":10,"rs":1,"cs":1,"text":"(45)"},{"c":11,"rs":1,"cs":1,"text":"(50)"},{"c":12,"rs":1,"cs":1,"text":"(55)"},{"c":13,"rs":1,"cs":1,"text":"(60)"},{"c":14,"rs":1,"cs":1,"text":"(65)"},{"c":15,"rs":1,"cs":1,"text":"(70)"},{"c":16,"rs":1,"cs":1,"text":"75"},{"c":17,"rs":1,"cs":1,"text":"76"},{"c":18,"rs":1,"cs":1,"text":"77"},{"c":19,"rs":1,"cs":1,"text":"78"},{"c":20,"rs":1,"cs":1,"text":"79"},{"c":21,"rs":1,"cs":1,"text":"80"},{"c":22,"rs":1,"cs":1,"text":"81"},{"c":23,"rs":1,"cs":1,"text":"82"},{"c":24,"rs":1,"cs":1,"text":"83"},{"c":25,"rs":1,"cs":1,"text":"84"},{"c":26,"rs":1,"cs":1,"text":"85"},{"c":27,"rs":1,"cs":1,"text":"86"},{"c":28,"rs":1,"cs":1,"text":"87"},{"c":29,"rs":1,"cs":1,"text":"88"},{"c":30,"rs":1,"cs":1,"text":"89"},{"c":31,"rs":1,"cs":1,"text":"90"},{"c":32,"rs":1,"cs":1,"text":"90"},{"c":33,"rs":1,"cs":1,"text":"90"}],[{"c":0,"rs":1,"cs":2,"text":"註記"},{"c":2,"rs":1,"cs":32,"text":"一、一次退休金：\n(一)任職未滿五年者不發，自滿五年起發給九個基數，爾後每增加半年加發一個基數，滿十五年後另行加發二個基數，但最高總數以六十一個基數為限。\n(二)任職未滿一年者，每一個月給與十二分之一個基數；任職滿一年以上者，其畸零月數年資，每一個月給與六分之一個基數。未滿一個月者，以一個月計。\n二、月退休金：任職一至十五年者，每任職一年按月照本法第二十七條第一項第一款或第二項第一款第二目所定退休金基數內涵給與百分之五之月退休金，未滿一年者，每一個月給與一千二百分之五；任職滿十五年者給與月俸額百分之七十五，爾後每增一年加發百分之一，未滿一年者，每一個月給與一千二百分之一，但以增至百分之九十為限。\n三、兼領一次退休金與月退休金者，依註記一、二兩項規定應領之退休給與，分別予以二分之一之一次退休金與二分之一之月退休金，按比率計算。\n四、身心障礙係因公傷病所致者：\n(一)一次退休金依註記一規定處理；任職未滿五年，以五年計算。\n(二)月退休金任職未滿二十年，以二十年計；超過二十年者，依一般規定處理。\n(三)兼領一次退休金與月退休金者，其一次退休金與月退休金，比照前述之比率計算。\n五、任職未滿一年之畸零月數基數內涵應以分數計算並計至小數點後第四位無條件進位。退休金以元為計算單位，不足一元者，以一元計。\n六、括弧部分指退撫新制實施後，具有新舊制年資辦理退休者，其舊制年資得按註記一、二規定計算基數或百分比。"}]],"head":1}],"law":"pub05","label":"附表一","title":"第二十九條附表－公務人員在退撫新制實施前任職年資退休金支給標準表"}