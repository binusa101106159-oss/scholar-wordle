{"id":"a08-5","blocks":[{"t":"p","text":"附表五：局部排氣裝置設計專業人員訓練課程及時數","center":false},{"t":"table","widths":[41.6,342.5,69.5],"rows":[[{"c":0,"rs":1,"cs":1,"text":"項次"},{"c":1,"rs":1,"cs":1,"text":"課程名稱"},{"c":2,"rs":1,"cs":1,"text":"時數\n（小時）"}],[{"c":0,"rs":1,"cs":1,"text":"1"},{"c":1,"rs":1,"cs":1,"text":"有害物危害預防法規"},{"c":2,"rs":1,"cs":1,"text":"2"}],[{"c":0,"rs":1,"cs":1,"text":"2"},{"c":1,"rs":1,"cs":1,"text":"暴露評估"},{"c":2,"rs":1,"cs":1,"text":"4"}],[{"c":0,"rs":1,"cs":1,"text":"3"},{"c":1,"rs":1,"cs":1,"text":"工業通風原理"},{"c":2,"rs":1,"cs":1,"text":"5"}],[{"c":0,"rs":1,"cs":1,"text":"4"},{"c":1,"rs":1,"cs":1,"text":"整體通風系統（原理、案例說明）"},{"c":2,"rs":1,"cs":1,"text":"5"}],[{"c":0,"rs":1,"cs":1,"text":"5"},{"c":1,"rs":1,"cs":1,"text":"局部通風系統設計（含氣罩設計與案例說明）"},{"c":2,"rs":1,"cs":1,"text":"15"}],[{"c":0,"rs":1,"cs":1,"text":"6"},{"c":1,"rs":1,"cs":1,"text":"管道系統設計與排氣機匹配（含案例說明及計算練\n習）"},{"c":2,"rs":1,"cs":1,"text":"15"}],[{"c":0,"rs":1,"cs":1,"text":"7"},{"c":1,"rs":1,"cs":1,"text":"空氣清淨裝置"},{"c":2,"rs":1,"cs":1,"text":"3"}],[{"c":0,"rs":1,"cs":1,"text":"8"},{"c":1,"rs":1,"cs":1,"text":"局部通風系統安裝施工、檢測、維修保養之方法及技術"},{"c":2,"rs":1,"cs":1,"text":"3"}],[{"c":0,"rs":1,"cs":1,"text":"9"},{"c":1,"rs":1,"cs":1,"text":"局部排氣裝置設計報告書與原始性能測試報告書之製作及練習"},{"c":2,"rs":1,"cs":1,"text":"8"}],[{"c":0,"rs":1,"cs":1,"text":"10"},{"c":1,"rs":1,"cs":1,"text":"工廠實習（含案例設計演練）"},{"c":2,"rs":1,"cs":1,"text":"12"}],[{"c":0,"rs":1,"cs":2,"text":"合計"},{"c":2,"rs":1,"cs":1,"text":"72"}]],"head":1},{"t":"p","text":"備註：","center":false},{"t":"p","text":"1、工廠實習之場地可為工廠、實習工廠或試驗工廠。","center":false},{"t":"p","text":"2、除 72 小時課程外，需配合工廠實習完成並提交 2 廠次局部排氣裝置設計報告書，且危害類別涵蓋氣態及粒狀有害物，經考試及報告書審核通過，方為訓練合格。","center":false}],"law":"a08","label":"附表五","title":"局部排氣裝置設計專業人員訓練課程及時數"}