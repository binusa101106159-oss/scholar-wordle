"t":"table","widths":[408.6],"rows":[[{"c":0,"rs":1,"cs":1,"text":"個人應注意事項："}],[{"c":0,"rs":1,"cs":1,"text":"環境注意事項："}],[{"c":0,"rs":1,"cs":1,"text":"清理方法："}]],"head":0},{"t":"p","text":"七、安全處置與儲存方法","center":false},{"t":"table","widths":[408.6],"rows":[[{"c":0,"rs":1,"cs":1,"text":"處置："}],[{"c":0,"rs":1,"cs":1,"text":"儲存："}]],"head":0},{"t":"p","text":"八、暴露預防措施","center":false},{"t":"table","widths":[408.6],"rows":[[{"c":0,"rs":1,"cs":1,"text":"工程控制："}],[{"c":0,"rs":1,"cs":1,"text":"控制參數：\n●八小時日時量平均容許濃度/短時間時量平均容許濃度/最高容許濃度：\n●生物指標："}],[{"c":0,"rs":1,"cs":1,"text":"個人防護設備：\n●呼吸防護：\n●手部防護：\n●眼睛防護：\n●皮膚及身體防護："}],[{"c":0,"rs":1,"cs":1,"text":"衛生措施："}]],"head":0},{"t":"p","text":"九、物理及化學性質","center":false},{"t":"table","widths":[204.3,204.3],"rows":[[{"c":0,"rs":1,"cs":1,"text":"外觀（物質狀態、顏色等）："},{"c":1,"rs":1,"cs":1,"text":"氣味："}],[{"c":0,"rs":1,"cs":1,"text":"運動黏度："},{"c":1,"rs":1,"cs":1,"text":"熔點："}],[{"c":0,"rs":1,"cs":1,"text":"pH 值："},{"c":1,"rs":1,"cs":1,"text":"沸點/沸點範圍："}],[{"c":0,"rs":1,"cs":1,"text":"易燃性（固體、氣體）："},{"c":1,"rs":2,"cs":1,"text":"閃火點:\n測試方法（開杯或閉杯）:"}],[{"c":0,"rs":1,"cs":1,"text":"分解溫度："}],[{"c":0,"rs":1,"cs":1,"text":"自燃溫度："},{"c":1,"rs":1,"cs":1,"text":"爆炸界限："}],[{"c":0,"rs":1,"cs":1,"text":"蒸氣壓："},{"c":1,"rs":1,"cs":1,"text":"蒸氣密度："}],[{"c":0,"rs":1,"cs":1,"text":"密度："},{"c":1,"rs":1,"cs":1,"text":"溶解度："}],[{"c":0,"rs":1,"cs":1,"text":"辛醇／水分配係數（log Kow）"},{"c":1,"rs":1,"cs":1,"text":"顆粒特性："}]],"head":1},{"t":"p","text":"十、安定性及反應性","center":false},{"t":"table","widths":[408.6],"rows":[[{"c":0,"rs":1,"cs":1,"text":"安定性："}],[{"c":0,"rs":1,"cs":1,"text":"特殊狀況下可能之危害反應："}],[{"c":0,"rs":1,"cs":1,"text":"應避免之狀況："}],[{"c":0,"rs":1,"cs":1,"text":"應避免之物質："}],[{"c":0,"rs":1,"cs":1,"text":"危害分解物："}]],"head":0},{"t":"p","text":"十一、毒性資料","center":false},{"t":"table","widths":[408.6],"rows":[[{"c":0,"rs":1,"cs":1,"text":"暴露途徑："}],[{"c":0,"rs":1,"cs":1,"text":"症狀："}],[{"c":0,"rs":1,"cs":1,"text":"急毒性："}],[{"c":0,"rs":1,"cs":1,"text":"慢毒性或長期毒性："}]],"head":0},{"t":"p","text":"十二、生態資料","center":false},{"t":"table","widths":[408.6],"rows":[[{"c":0,"rs":1,"cs":1,"text":"生態毒性："}],[{"c":0,"rs":1,"cs":1,"text":"持久性及降解性："}],[{"c":0,"rs":1,"cs":1,"text":"生物蓄積性："}],[{"c":0,"rs":1,"cs":1,"text":"土壤中之流動性："}],[{"c":0,"rs":1,"cs":1,"text":"其他不良效應："}]],"head":0},{"t":"p","text":"十三、廢棄處置方法","center":false},{"t":"p","text":"廢棄處置方法：","center":false},{"t":"p","text":"十四、運送資料","center":false},{"t":"table","widths":[408.6],"rows":[[{"c":0,"rs":1,"cs":1,"text":"聯合國編號："}],[{"c":0,"rs":1,"cs":1,"text":"聯合國運輸名稱："}],[{"c":0,"rs":1,"cs":1,"text":"運輸危害分類："}],[{"c":0,"rs":1,"cs":1,"text":"包裝類別："}],[{"c":0,"rs":1,"cs":1,"text":"散裝貨運運輸規定："}],[{"c":0,"rs":1,"cs":1,"text":"海洋污染物（是／否）："}],[{"c":0,"rs":1,"cs":1,"text":"特殊運送方法及注意事項："}]],"head":0},{"t":"p","text":"十五、法規資料","center":false},{"t":"p","text":"適用法規：","center":false},{"t":"p","text":"十六、其他資料","center":false},{"t":"table","widths":[60.6,348.0],"rows":[[{"c":0,"rs":1,"cs":1,"text":"參考文獻"},{"c":1,"rs":1,"cs":1,"text":""}],[{"c":0,"rs":2,"cs":1,"text":"製表單位"},{"c":1,"rs":1,"cs":1,"text":"名稱："}],[{"c":1,"rs":1,"cs":1,"text":"地址/電話："}],[{"c":0,"rs":1,"cs":1,"text":"製表日期"},{"c":1,"rs":1,"cs":1,"text":""}]],"head":1},{"t":"p","text":"安全資料表應列內容項目說明：","center":false},{"t":"p","text":"一、化學品與廠商資料：","center":false},{"t":"p","text":"化學品名稱、其他名稱、建議用途及限制使用、製造者、輸入者或供應者名稱、地址及電話、緊急聯絡電話/傳真電話。","center":false},{"t":"p","text":"二、危害辨識資料：","center":false},{"t":"p","text":"化學品危害分類、標示內容、其他危害。","center":false},{"t":"p","text":"三、成分辨識資料：","center":false},{"t":"p","text":"純物質：中英文名稱、同義名稱、化學文摘社登記號碼（CAS No.)、危害成分（成分百分比)。","center":false},{"t":"p","text":"混合物：危害成分之中英文名稱、化學文摘社登記號碼（CAS No.）、濃度或濃度範圍（成分百分比）。","center":false},{"t":"p","text":"註：危害成分確無化學文摘社登記號碼，得免列該號碼。","center":false},{"t":"p","text":"四、急救措施：","center":false},{"t":"p","text":"不同暴露途徑之急救方法、最重要症狀及危害效應、對急救人員之防護、對醫師之提示。","center":false},{"t":"p","text":"五、滅火措施：","center":false},{"t":"p","text":"適用滅火劑、滅火時可能遭遇之特殊危害、特殊滅火程序、消防人員之特殊防護設備。","center":false},{"t":"p","text":"六、洩漏處理方法：","center":false},{"t":"p","text":"個人應注意事項、環境注意事項、清理方法。","center":false},{"t":"p","text":"七、安全處置與儲存方法：","center":false},{"t":"p","text":"處置、儲存。","center":false},{"t":"p","text":"八、暴露預防措施：","center":false},{"t":"p","text":"工程控制、控制參數、個人防護設備、衛生措施。","center":false},{"t":"p","text":"九、物理及化學性質：","center":false},{"t":"p","text":"外觀（物質狀態、顏色）、氣味、運動黏度、pH 值、熔點、沸點/沸點範圍、易燃性（固體、氣體）、分解溫度、閃火點、自燃溫度、爆炸界限、蒸氣壓、蒸氣密度、密度、溶解度、辛醇／水分配係數（log Kow）、顆粒特性。","center":true},{"t":"p","text":"十、安定性及反應性：","center":false},{"t":"p","text":"安定性、特殊狀況下可能之危害反應、應避免之狀況、應避免之物質、危害分解物。","center":false},{"t":"p","text":"十一、毒性資料：","center":false},{"t":"p","text":"暴露途徑、症狀、急毒性、慢毒性或長期毒性。","center":false},{"t":"p","text":"十二、生態資料：","center":false},{"t":"p","text":"生態毒性、持久性及降解性、生物蓄積性、土壤中之流動性、其他不良效應。","center":false},{"t":"p","text":"十三、廢棄處置方法：","center":false},{"t":"p","text":"廢棄處置方法。","center":false},{"t":"p","text":"十四、運送資料：","center":false},{"t":"p","text":"聯合國編號、聯合國運輸名稱、運輸危害分類、包裝類別、散裝貨物運輸規定、海洋污染物（是／否）、特殊運送方法及注意事項。","center":true},{"t":"p","text":"十五、法規資料：","center":false},{"t":"p","text":"適用法規。","center":false},{"t":"p","text":"十六、其他資料：","center":false},{"t":"p","text":"參考文獻、製表單位、製表日期。","center":false}],"law":"s13","label":"附表四","title":"安全資料表應列內容項目及參考格式"}