{"id":"s01-4","blocks":[{"t":"p","text":"第四條附表四修正規定","center":false},{"t":"p","text":"附表四 勞工人數50人以上未達300人之事業單位醫護人員臨場服務頻率表","center":false},{"t":"table","widths":[56.7,99.7,70.8,63.3,148.5],"rows":[[{"c":0,"rs":2,"cs":1,"text":"事業性質分類"},{"c":1,"rs":2,"cs":1,"text":"勞工人數"},{"c":2,"rs":1,"cs":2,"text":"臨場服務頻率"},{"c":4,"rs":2,"cs":1,"text":"備註"}],[{"c":2,"rs":1,"cs":1,"text":"醫師"},{"c":3,"rs":1,"cs":1,"text":"護理人員"}],[{"c":0,"rs":1,"cs":1,"text":"各類"},{"c":1,"rs":1,"cs":1,"text":"50-99人，並具特別危害健康作業1人以上"},{"c":2,"rs":1,"cs":1,"text":"1次/年"},{"c":3,"rs":1,"cs":1,"text":"1次/月"},{"c":4,"rs":7,"cs":1,"text":"一、雇主應使醫護人員會同事業單位之職業安全衛生人員，每年度至少進行現場訪視1次，並共同研訂年度勞工健康服務之重點工作事項。\n二、每年或每月安排臨場服務期程之間隔，應依事業單位作業特性及勞工健康需求規劃，每次臨場服務之時間應至少2小時以上，且每日不得超過2場次。\n三、事業單位從事特別危害健康作業之勞工人數在50人以上者，應另分別依附表二及附表三所定之人力配置及臨場服務頻率，特約職業醫學科專科醫師及僱用從事勞工健康服務之護理人員，辦理勞工健康服務。"}],[{"c":0,"rs":2,"cs":1,"text":"第一類"},{"c":1,"rs":1,"cs":1,"text":"100-199人"},{"c":2,"rs":1,"cs":1,"text":"1次/3個月"},{"c":3,"rs":1,"cs":1,"text":"4次/月"}],[{"c":1,"rs":1,"cs":1,"text":"200-299人"},{"c":2,"rs":1,"cs":1,"text":"1次/2個月"},{"c":3,"rs":1,"cs":1,"text":"6次/月"}],[{"c":0,"rs":2,"cs":1,"text":"第二類"},{"c":1,"rs":1,"cs":1,"text":"100-199人"},{"c":2,"rs":1,"cs":1,"text":"1次/4個月"},{"c":3,"rs":1,"cs":1,"text":"3次/月"}],[{"c":1,"rs":1,"cs":1,"text":"200-299人"},{"c":2,"rs":1,"cs":1,"text":"1次/3個月"},{"c":3,"rs":1,"cs":1,"text":"4次/月"}],[{"c":0,"rs":2,"cs":1,"text":"第三類"},{"c":1,"rs":1,"cs":1,"text":"100-199人"},{"c":2,"rs":1,"cs":1,"text":"1次/6個月"},{"c":3,"rs":1,"cs":1,"text":"2次/月"}],[{"c":1,"rs":1,"cs":1,"text":"200-299人"},{"c":2,"rs":1,"cs":1,"text":"1次/4個月"},{"c":3,"rs":1,"cs":1,"text":"3次/月"}]],"head":2}],"law":"s01","label":"附表四","title":"勞工人數50人以上未達300人之事業單位醫護人員臨場服務頻率表"}