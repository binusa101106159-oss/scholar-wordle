{"id":"s06-2","blocks":[{"t":"p","text":"附表二 空氣中粉塵容許濃度","center":false},{"t":"table","widths":[61.0,60.2,42.1,20.6,230.7],"rows":[[{"c":0,"rs":2,"cs":1,"text":"粉塵"},{"c":1,"rs":1,"cs":2,"text":"容許濃度"},{"c":3,"rs":2,"cs":1,"text":"符號"},{"c":4,"rs":2,"cs":1,"text":"化學文摘社號碼（CAS No.）"}],[{"c":1,"rs":1,"cs":1,"text":"可呼吸性粉塵"},{"c":2,"rs":1,"cs":1,"text":"總粉塵"}],[{"c":0,"rs":1,"cs":1,"text":"結晶型游離二氧化矽"},{"c":1,"rs":1,"cs":1,"text":"0.1 mg/m3"},{"c":2,"rs":1,"cs":1,"text":"-"},{"c":3,"rs":1,"cs":1,"text":"瘤"},{"c":4,"rs":1,"cs":1,"text":"14808-60-7; 15468-32-3; 14464-46-1"}],[{"c":0,"rs":1,"cs":1,"text":"石綿纖維"},{"c":1,"rs":1,"cs":2,"text":"0.15 f/cc"},{"c":3,"rs":1,"cs":1,"text":"瘤"},{"c":4,"rs":1,"cs":1,"text":"1332-21-4; 12001-28-4; 12172-73-5; 77536-66-4; 77536-67-5; 77536-68-6; 132207-32-0"}],[{"c":0,"rs":1,"cs":1,"text":"厭惡性粉塵"},{"c":1,"rs":1,"cs":1,"text":"5 mg/m3"},{"c":2,"rs":1,"cs":1,"text":"10 mg/m3"},{"c":3,"rs":1,"cs":1,"text":""},{"c":4,"rs":1,"cs":1,"text":""}]],"head":2},{"t":"p","text":"說明：一、本表內所規定之容許濃度均為八小時日時量平均容許濃度。","center":false},{"t":"p","text":"二、可呼吸性粉塵係指會進入無纖毛呼吸道之粉塵。","center":false},{"t":"p","text":"三、總粉塵係指在某一特定體積空氣中，懸浮在空氣中之全部粉塵。","center":true},{"t":"p","text":"四、結晶型游離二氧化矽係指石英、方矽石及鱗矽石。","center":false},{"t":"p","text":"五、石綿粉塵係指纖維長度在五微米以上，直徑小於三微米，且長寬比在三以上之粉塵。","center":false}],"law":"s06","label":"附表二","title":"空氣中粉塵容許濃度"}