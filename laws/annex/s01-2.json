{"id":"s01-2","blocks":[{"t":"p","text":"第三條附表二修正規定","center":false},{"t":"p","text":"附表二 從事勞工健康服務之醫師人力配置及臨場服務頻率表","center":false},{"t":"table","widths":[56.7,107.7,141.6,127.5],"rows":[[{"c":0,"rs":1,"cs":1,"text":"事業性質分類"},{"c":1,"rs":1,"cs":1,"text":"勞工人數"},{"c":2,"rs":1,"cs":1,"text":"人力配置或\n臨場服務頻率"},{"c":3,"rs":1,"cs":1,"text":"備註"}],[{"c":0,"rs":2,"cs":1,"text":"各類"},{"c":1,"rs":1,"cs":1,"text":"特別危害健康作業50-99人"},{"c":2,"rs":1,"cs":1,"text":"職業醫學科專科醫師：1次/4個月"},{"c":3,"rs":23,"cs":1,"text":"一、勞工人數超過6,000 人者，每增勞工1,000人，應依下列標準增加其從事勞工健康服務之醫師臨場服務頻率：\n（一）第一類：3次/月。\n（二）第二類：2次/月。\n（三）第三類：1次/月。\n二、每次臨場服務之時間，應至少3小時以上。"}],[{"c":1,"rs":1,"cs":1,"text":"特別危害健康作業100人以上"},{"c":2,"rs":1,"cs":1,"text":"職業醫學科專科醫師：1次/月"}],[{"c":0,"rs":7,"cs":1,"text":"第一類"},{"c":1,"rs":1,"cs":1,"text":"300-999人"},{"c":2,"rs":1,"cs":1,"text":"1次/月"}],[{"c":1,"rs":1,"cs":1,"text":"1,000-1,999人"},{"c":2,"rs":1,"cs":1,"text":"3次/月"}],[{"c":1,"rs":1,"cs":1,"text":"2,000-2,999人"},{"c":2,"rs":1,"cs":1,"text":"6次/月"}],[{"c":1,"rs":1,"cs":1,"text":"3,000-3,999人"},{"c":2,"rs":1,"cs":1,"text":"9次/月"}],[{"c":1,"rs":1,"cs":1,"text":"4,000-4,999人"},{"c":2,"rs":1,"cs":1,"text":"12次/月"}],[{"c":1,"rs":1,"cs":1,"text":"5,000-5,999人"},{"c":2,"rs":1,"cs":1,"text":"15次/月"}],[{"c":1,"rs":1,"cs":1,"text":"6,000人以上"},{"c":2,"rs":1,"cs":1,"text":"專任職業醫學科專科醫師一人或18次/月"}],[{"c":0,"rs":7,"cs":1,"text":"第二類"},{"c":1,"rs":1,"cs":1,"text":"300-999人"},{"c":2,"rs":1,"cs":1,"text":"1次/2個月"}],[{"c":1,"rs":1,"cs":1,"text":"1,000-1,999人"},{"c":2,"rs":1,"cs":1,"text":"1次/月"}],[{"c":1,"rs":1,"cs":1,"text":"2,000-2,999人"},{"c":2,"rs":1,"cs":1,"text":"3次/月"}],[{"c":1,"rs":1,"cs":1,"text":"3,000-3,999人"},{"c":2,"rs":1,"cs":1,"text":"5次/月"}],[{"c":1,"rs":1,"cs":1,"text":"4,000-4,999人"},{"c":2,"rs":1,"cs":1,"text":"7次/月"}],[{"c":1,"rs":1,"cs":1,"text":"5,000-5,999人"},{"c":2,"rs":1,"cs":1,"text":"9次/月"}],[{"c":1,"rs":1,"cs":1,"text":"6,000人以上"},{"c":2,"rs":1,"cs":1,"text":"12次/月"}],[{"c":0,"rs":7,"cs":1,"text":"第三類"},{"c":1,"rs":1,"cs":1,"text":"300-999人"},{"c":2,"rs":1,"cs":1,"text":"1次/3個月"}],[{"c":1,"rs":1,"cs":1,"text":"1,000-1,999人"},{"c":2,"rs":1,"cs":1,"text":"1次/2個月"}],[{"c":1,"rs":1,"cs":1,"text":"2,000-2,999人"},{"c":2,"rs":1,"cs":1,"text":"1次/月"}],[{"c":1,"rs":1,"cs":1,"text":"3,000-3,999人"},{"c":2,"rs":1,"cs":1,"text":"2次/月"}],[{"c":1,"rs":1,"cs":1,"text":"4,000-4,999人"},{"c":2,"rs":1,"cs":1,"text":"3次/月"}],[{"c":1,"rs":1,"cs":1,"text":"5,000-5,999人"},{"c":2,"rs":1,"cs":1,"text":"4次/月"}],[{"c":1,"rs":1,"cs":1,"text":"6,000人以上"},{"c":2,"rs":1,"cs":1,"text":"6次/月"}]],"head":1}],"law":"s01","label":"附表二","title":"從事勞工健康服務之醫師人力配置及臨場服務頻率表"}