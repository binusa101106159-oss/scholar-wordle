{"id":"s01-7","blocks":[{"t":"p","text":"第十三條附表七修正規定","center":false},{"t":"p","text":"附表七 第十三條所定事業單位從事勞工健康服務之醫護人力配置及臨場服務頻率表","center":false},{"t":"table","widths":[84.8,81.4,81.6,191.2],"rows":[[{"c":0,"rs":1,"cs":1,"text":"勞工人數"},{"c":1,"rs":1,"cs":1,"text":"醫師臨場服務頻率"},{"c":2,"rs":1,"cs":1,"text":"護理人員臨場服務頻率"},{"c":3,"rs":1,"cs":1,"text":"備註"}],[{"c":0,"rs":1,"cs":1,"text":"50-299人"},{"c":1,"rs":1,"cs":1,"text":"1次/年"},{"c":2,"rs":1,"cs":1,"text":"1次/3個月"},{"c":3,"rs":4,"cs":1,"text":"一、勞工人數3,000人以上者，應另僱用勞工健康服務之護理人員至少一人，綜理勞工健康服務事務，規劃與推動勞工健康服務之政策及計畫。\n二、臨場服務之工作場所，得依實務需求規劃，每次服務時間應至少2小時以上。\n三、勞工人數50-99人，且未具特別危害健康作業者，未適用本表。"}],[{"c":0,"rs":1,"cs":1,"text":"300-999人"},{"c":1,"rs":1,"cs":1,"text":"1次/6個月"},{"c":2,"rs":1,"cs":1,"text":"1次/2個月"}],[{"c":0,"rs":1,"cs":1,"text":"1,000-2,999人"},{"c":1,"rs":1,"cs":1,"text":"1次/3個月"},{"c":2,"rs":1,"cs":1,"text":"1次/1個月"}],[{"c":0,"rs":1,"cs":1,"text":"3,000人以上"},{"c":1,"rs":1,"cs":1,"text":"1次/2個月"},{"c":2,"rs":1,"cs":1,"text":"1次/1個月"}]],"head":1}],"law":"s01","label":"附表七","title":"第十三條所定事業單位從事勞工健康服務之醫護人力配置及臨場服務頻率表"}