{"id":"brief26-quick4","guide":"brief26","label":"表格 4","title":"四、 健康管理附註資料","blocks":[{"t":"table","widths":[91.9,361.5],"rows":[[{"c":0,"rs":1,"cs":1,"text":"健康管理分級"},{"c":1,"rs":1,"cs":1,"text":"建議"}],[{"c":0,"rs":1,"cs":1,"text":"第一級管理"},{"c":1,"rs":1,"cs":1,"text":"無特殊規定。"}],[{"c":0,"rs":1,"cs":1,"text":"第二級管理"},{"c":1,"rs":3,"cs":1,"text":"考量不適合從事作業之疾病，如呼吸系統疾病(如：氣喘、慢性支氣管炎、慢性鼻竇炎、塵肺症或肺癌等疾病)與鎳暴露引起的接觸性或過敏性皮膚炎，及妊娠中勞工之健康保護。"}],[{"c":0,"rs":1,"cs":1,"text":"第三級管理"}],[{"c":0,"rs":1,"cs":1,"text":"第四級管理"}]],"head":1,"pdf_page":63,"pdf_last":63,"source":"簡明版.pdf"}]}