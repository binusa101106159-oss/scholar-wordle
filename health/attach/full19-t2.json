{"id":"full19-t2","guide":"full19","label":"表二","title":"常見砷及其化合物的化學名稱、CAS 編號及化學式","blocks":[{"t":"p","text":"表二、常見砷及其化合物的化學名稱、CAS 編號及化學式","cap":"full19-t2","pdf_page":446,"pdf_last":446,"source":"完整版.pdf"},{"t":"table","widths":[105,65,178,82],"head":2,"rows":[[{"text":"Table 1.1 Chemical names, CAS numbers, synonyms, and molecular formulae of arsenic and arsenic compounds","c":0,"cs":4,"rs":1}],[{"text":"Chemical name","c":0,"cs":1,"rs":1},{"text":"CAS Reg. No.","c":1,"cs":1,"rs":1},{"text":"Synonyms","c":2,"cs":1,"rs":1},{"text":"Formula","c":3,"cs":1,"rs":1}],[{"text":"Arsanilic acid","c":0,"cs":1,"rs":1},{"text":"98-50-0","c":1,"cs":1,"rs":1},{"text":"Arsonic acid, (4-aminophenyl)-","c":2,"cs":1,"rs":1},{"text":"C₆H₈AsNO₃","c":3,"cs":1,"rs":1}],[{"text":"Arsenicᵃ","c":0,"cs":1,"rs":1},{"text":"7440-38-2","c":1,"cs":1,"rs":1},{"text":"Metallic arsenic","c":2,"cs":1,"rs":1},{"text":"As","c":3,"cs":1,"rs":1}],[{"text":"Arsenic(V) pentoxideᵇ","c":0,"cs":1,"rs":1},{"text":"1303-28-2","c":1,"cs":1,"rs":1},{"text":"Arsenic oxide [As₂O₅]","c":2,"cs":1,"rs":1},{"text":"As₂O₅","c":3,"cs":1,"rs":1}],[{"text":"Arsenic(III) sulfide","c":0,"cs":1,"rs":1},{"text":"1303-33-9","c":1,"cs":1,"rs":1},{"text":"Arsenic sulfide [As₂S₃]","c":2,"cs":1,"rs":1},{"text":"As₂S₃","c":3,"cs":1,"rs":1}],[{"text":"Arsenic(III) trichloride","c":0,"cs":1,"rs":1},{"text":"7784-34-1","c":1,"cs":1,"rs":1},{"text":"Arsenic chloride [AsCl₃]","c":2,"cs":1,"rs":1},{"text":"AsCl₃","c":3,"cs":1,"rs":1}],[{"text":"Arsenic(III) trioxideᵃ,ᶜ","c":0,"cs":1,"rs":1},{"text":"1327-53-3","c":1,"cs":1,"rs":1},{"text":"Arsenic oxide [As₂O₃]","c":2,"cs":1,"rs":1},{"text":"As₂O₃","c":3,"cs":1,"rs":1}],[{"text":"Arsenobetaine","c":0,"cs":1,"rs":1},{"text":"64436-13-1","c":1,"cs":1,"rs":1},{"text":"Arsonium, (carboxymethyl) trimethyl-, hydroxide, inner salt; 2-(trimethylarsonio)acetate","c":2,"cs":1,"rs":1},{"text":"C₅H₁₁AsO₂","c":3,"cs":1,"rs":1}],[{"text":"Arsine","c":0,"cs":1,"rs":1},{"text":"7784-42-1","c":1,"cs":1,"rs":1},{"text":"Arsenic hydride","c":2,"cs":1,"rs":1},{"text":"AsH₃","c":3,"cs":1,"rs":1}],[{"text":"Calcium arsenate","c":0,"cs":1,"rs":1},{"text":"7778-44-1","c":1,"cs":1,"rs":1},{"text":"Arsenic acid [H₃AsO₄] calcium salt (2:3)","c":2,"cs":1,"rs":1},{"text":"(AsO₄)₂.3Ca","c":3,"cs":1,"rs":1}],[{"text":"Dimethylarsinic acid","c":0,"cs":1,"rs":1},{"text":"75-60-5","c":1,"cs":1,"rs":1},{"text":"Cacodylic acid","c":2,"cs":1,"rs":1},{"text":"C₂H₇AsO₂","c":3,"cs":1,"rs":1}],[{"text":"Lead arsenate","c":0,"cs":1,"rs":1},{"text":"7784-40-9","c":1,"cs":1,"rs":1},{"text":"Arsenic acid [H₃AsO₄], lead (2+) salt (1:1)","c":2,"cs":1,"rs":1},{"text":"HAsO₄.Pb","c":3,"cs":1,"rs":1}],[{"text":"Methanearsonic acid, disodium salt","c":0,"cs":1,"rs":1},{"text":"144-21-8","c":1,"cs":1,"rs":1},{"text":"Arsonic acid, methyl-, disodium salt","c":2,"cs":1,"rs":1},{"text":"CH₃AsO₃.2Na","c":3,"cs":1,"rs":1}],[{"text":"Methanearsonic acid, monosodium salt","c":0,"cs":1,"rs":1},{"text":"2163-80-6","c":1,"cs":1,"rs":1},{"text":"Arsonic acid, methyl-, monosodium salt","c":2,"cs":1,"rs":1},{"text":"CH₄AsO₃.Na","c":3,"cs":1,"rs":1}],[{"text":"Potassium arsenateᵈ","c":0,"cs":1,"rs":1},{"text":"7784-41-0","c":1,"cs":1,"rs":1},{"text":"Arsenic acid [H₃AsO₄], monopotassium salt","c":2,"cs":1,"rs":1},{"text":"H₂AsO₄.K","c":3,"cs":1,"rs":1}],[{"text":"Potassium arsenite","c":0,"cs":1,"rs":1},{"text":"13464-35-2","c":1,"cs":1,"rs":1},{"text":"Arsenous acid, potassium salt","c":2,"cs":1,"rs":1},{"text":"AsO₂.K","c":3,"cs":1,"rs":1}],[{"text":"Sodium arsenateᵉ","c":0,"cs":1,"rs":1},{"text":"7631-89-2","c":1,"cs":1,"rs":1},{"text":"Arsenic acid, [H₃AsO₄], monosodium salt","c":2,"cs":1,"rs":1},{"text":"H₂AsO₄.Na","c":3,"cs":1,"rs":1}],[{"text":"Sodium arsenite","c":0,"cs":1,"rs":1},{"text":"7784-46-5","c":1,"cs":1,"rs":1},{"text":"Arsenous acid, sodium salt","c":2,"cs":1,"rs":1},{"text":"AsO₂.Na","c":3,"cs":1,"rs":1}],[{"text":"Sodium cacodylate","c":0,"cs":1,"rs":1},{"text":"124-65-2","c":1,"cs":1,"rs":1},{"text":"Arsinic acid, dimethyl-, sodium salt","c":2,"cs":1,"rs":1},{"text":"C₂H₆AsO₂.Na","c":3,"cs":1,"rs":1}],[{"text":"ᵃ As₂O₃ is sometimes erroneously called ‘arsenic’.","c":0,"cs":4,"rs":1}],[{"text":"ᵇ The name ‘arsenic acid’ is commonly used for As₂O₅ as well as for the various hydrated products (H₃AsO₄, H₄As₂O₇).","c":0,"cs":4,"rs":1}],[{"text":"ᶜ As₂O₃ is sometimes called ‘arsenic oxide’, but this name is more properly used for As₂O₅.","c":0,"cs":4,"rs":1}],[{"text":"ᵈ The other salts, K₃AsO₄ and K₂HAsO₄, do not appear to be produced commercially.","c":0,"cs":4,"rs":1}],[{"text":"ᵉ The name ‘sodium arsenate’ is also applied to both the disodium [7778-43-0] and the trisodium [13464-38-5] salts; it is therefore not always possible to determine which substance is under discussion.","c":0,"cs":4,"rs":1}]],"att":"full19-t2","pdf_page":446,"pdf_last":446,"source":"完整版.pdf"}]}