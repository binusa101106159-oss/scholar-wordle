{"id":"full05-t2","guide":"full05","label":"表二","title":"工作場所空氣鉛暴露濃度與鉛作業勞工血中鉛標準與建議","blocks":[{"t":"p","text":"表二、工作場所空氣鉛暴露濃度與鉛作業勞工血中鉛標準與建議","cap":"full05-t2","pdf_page":127,"pdf_last":127,"source":"完整版.pdf"},{"t":"table","widths":[65.4,84.9,103.7,137.9],"rows":[[{"c":0,"rs":1,"cs":1,"text":"國別"},{"c":1,"rs":1,"cs":1,"text":"項目"},{"c":2,"rs":1,"cs":1,"text":"標準"},{"c":3,"rs":1,"cs":1,"text":"敘述"}],[{"c":0,"rs":2,"cs":1,"text":"臺灣"},{"c":1,"rs":1,"cs":1,"text":"工作場所空氣鉛暴露濃度"},{"c":2,"rs":1,"cs":1,"text":"八小時日時量平均容許濃度 : 0.05 mg/m3"},{"c":3,"rs":1,"cs":1,"text":"勞工作業場所容許暴露標準規定。"}],[{"c":1,"rs":1,"cs":1,"text":"鉛作業勞工血中鉛"},{"c":2,"rs":1,"cs":1,"text":"男性 : 40 μg/dL女性 : 30 μg/dL"},{"c":3,"rs":1,"cs":1,"text":"勞動部勞工特殊健康檢查健康管理分級建議指引中之血中鉛標準。"}],[{"c":0,"rs":1,"cs":1,"text":"OSHA"},{"c":1,"rs":1,"cs":1,"text":"工作場所空氣鉛暴露濃度"},{"c":2,"rs":1,"cs":1,"text":"Action level:\n0.03 mg/m3 PEL-TWA5(8-hour): 0.05 mg/m3"},{"c":3,"rs":1,"cs":1,"text":"美國 OSHA 法定之行動標準（action level）與八小時日時量平均容許濃度。"}],[{"c":0,"rs":1,"cs":1,"text":"OSHA"},{"c":1,"rs":1,"cs":1,"text":"鉛作業勞工血中鉛"},{"c":2,"rs":1,"cs":1,"text":"Medical Removal: 50-60 μg/dL Return to work:\n40 μg/dL"},{"c":3,"rs":1,"cs":1,"text":"鉛暴露濃度超過 action level 者，血鉛若超過 60μg/dL 或平均超過 50μg/dL 者，應暫時調離鉛作業，直到血中鉛低於 40 μg/dL 才可回復鉛作業。"}],[{"c":0,"rs":2,"cs":1,"text":"NIOSH"},{"c":1,"rs":1,"cs":1,"text":"工作場所空氣鉛暴露濃度"},{"c":2,"rs":1,"cs":1,"text":"REL6-TWA (8-hour): 50 ug/m3"},{"c":3,"rs":1,"cs":1,"text":"NIOSH 建議之八小時日時量平均容許濃度。"}],[{"c":1,"rs":1,"cs":1,"text":"鉛作業勞工血中鉛"},{"c":2,"rs":1,"cs":1,"text":"NEP7: 25 μg/dL"},{"c":3,"rs":1,"cs":1,"text":"NIOSH 將消除導致工人血鉛濃度超過 25 μg/dL的鉛暴露，作為美國的國家目標之一。"}],[{"c":0,"rs":2,"cs":1,"text":"ACGIH"},{"c":1,"rs":1,"cs":1,"text":"工作場所空氣鉛暴露濃度"},{"c":2,"rs":1,"cs":1,"text":"TLV8-TWA (8-hour): 0.05 mg/m3"},{"c":3,"rs":1,"cs":1,"text":"ACGIH 建議之八小時日時量平均容許濃度。"}],[{"c":1,"rs":1,"cs":1,"text":"鉛作業勞工血中鉛"},{"c":2,"rs":1,"cs":1,"text":"BEI: 20μg/dL"},{"c":3,"rs":1,"cs":1,"text":"ACGIH 自 2016 年已將BEI 自 30 μg/dL 調降至 20 μg/dL。"}],[{"c":0,"rs":1,"cs":1,"text":"AOEC9, CDPH10, ACOEM11, MIOSHA12"},{"c":1,"rs":1,"cs":1,"text":"鉛作業勞工血中鉛"},{"c":2,"rs":1,"cs":1,"text":"Medical removal: 30 μg/dL"},{"c":3,"rs":1,"cs":1,"text":"表列各個單位認定當血鉛超過 30 μg/dL 時建議將勞工調離鉛作業。"}]],"head":1,"att":"full05-t2","pdf_page":127,"pdf_last":127,"source":"完整版.pdf"},{"t":"p","text":"備註：","att":"full05-t2","pdf_page":128,"pdf_last":128,"source":"完整版.pdf"}]}