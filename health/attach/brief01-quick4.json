{"id":"brief01-quick4","guide":"brief01","label":"表格 4","title":"四、 健康管理附註資料","blocks":[{"t":"table","widths":[99.8,370.2],"rows":[[{"c":0,"rs":1,"cs":1,"text":"健康管理分級"},{"c":1,"rs":1,"cs":1,"text":"建議"}],[{"c":0,"rs":1,"cs":1,"text":"第一級管理"},{"c":1,"rs":1,"cs":1,"text":"無特殊規定。"}],[{"c":0,"rs":1,"cs":1,"text":"第二級管理"},{"c":1,"rs":3,"cs":1,"text":"考量不適合從事作業之疾病，如高血壓、心臟病、呼吸系統疾病、內分泌系統疾病、無汗症、腎臟疾病、廣泛性皮膚疾病等，及妊娠中勞工之健康保護。"}],[{"c":0,"rs":1,"cs":1,"text":"第三級管理"}],[{"c":0,"rs":1,"cs":1,"text":"第四級管理"}]],"head":1,"pdf_page":8,"pdf_last":8,"source":"簡明版.pdf"}]}