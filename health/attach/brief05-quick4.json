{"id":"brief05-quick4","guide":"brief05","label":"表格 4","title":"四、 健康管理附註資料","blocks":[{"t":"table","widths":[112.6,10.8,347.4],"rows":[[{"c":0,"rs":1,"cs":1,"text":"健康管理分級"},{"c":1,"rs":1,"cs":1,"text":""},{"c":2,"rs":1,"cs":1,"text":"建議"}],[{"c":0,"rs":1,"cs":2,"text":"第一級管理"},{"c":2,"rs":1,"cs":1,"text":"無特殊規定。"}],[{"c":0,"rs":1,"cs":2,"text":"第二級管理"},{"c":2,"rs":3,"cs":1,"text":"考量不適合從事作業之疾病，如神經系統疾病、貧血等血液疾病、腎臟疾病、消化系統疾病、肝病、內分泌系統疾病、視網膜病變、酒精中毒、高血壓，及妊娠中勞工之健康保護。"}],[{"c":0,"rs":1,"cs":2,"text":"第三級管理"}],[{"c":0,"rs":1,"cs":2,"text":"第四級管理"}]],"head":1,"pdf_page":17,"pdf_last":17,"source":"簡明版.pdf"}]}